  "panels": [
    {
      "title": "Weather Observations Ingested by Source",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (source, status) (rate(weathergpt_observations_total[5m]))",
          "legendFormat": "{{source}} ({{status}})"
        }
      ]
    },
    {
      "title": "Disaster Alerts Generated by Hazard Type",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (hazard_type, severity) (rate(weathergpt_alerts_total[5m]))",
          "legendFormat": "{{hazard_type}} - {{severity}}"
        }
      ]
    },
    {
      "title": "LLM Inference Latency (p95)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(weathergpt_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "{{provider}} p95"
        }
      ]
    },
    {
      "title": "Connector Fetch Latency (p95)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(weathergpt_connector_latency_seconds_bucket[5m])))",
          "legendFormat": "{{source}} p95"
        }
      ]
    }
  ],
