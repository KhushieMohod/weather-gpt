# ==============================================================================
# WeatherGPT Environment Configuration Template
# ==============================================================================

# Database Configuration
DATABASE_URL=sqlite:///./weather_gpt.db
# For PostgreSQL production:
# DATABASE_URL=postgresql://weather_user:weather_password@localhost:5432/weather_gpt

# Large Language Model (LLM) Configuration
LLM_PROVIDER=gemini                     # Options: gemini, openai, mock
LLM_FALLBACK_PROVIDER=openai           # Optional fallback provider
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Scheduled Ingestion Pipeline
ENABLE_SCHEDULER=true
ENABLE_RISK_MONITOR=true
IMD_FETCH_CRON=*/15 * * * *            # Every 15 minutes
MOSDAC_FETCH_CRON=*/30 * * * *         # Every 30 minutes
GFS_FETCH_CRON=0 */6 * * *             # Every 6 hours (00, 06, 12, 18 UTC)
ERA5_FETCH_CRON=0 6 * * *              # Daily at 06:00 UTC

# IMD (India Meteorological Department) Connector
IMD_BASE_URL=https://mausam.imd.gov.in/api
IMD_FORECAST_URL=https://internal.imd.gov.in/section/nhac/dynamic/allindia.json
IMD_TIMEOUT_SECONDS=20

# ISRO MOSDAC Connector
MOSDAC_BASE_URL=https://www.mosdac.gov.in/api
MOSDAC_API_KEY=your_mosdac_api_token
MOSDAC_PRODUCT_IDS=3D_L2B_HEM,3D_L2B_IMG

# NOAA GFS (Global Forecast System) Connector
GFS_NOMADS_URL=https://nomads.ncep.noaa.gov/cgi-bin/filter_gfs_0p25.pl
GFS_RESOLUTION=0.5                     # 0.25, 0.5, or 1.0
GFS_FORECAST_HOURS=24
GFS_BBOX_INDIA=6.0,68.0,38.0,98.0      # min_lat, min_lon, max_lat, max_lon

# ECMWF ERA5 (Climate Data Store) Connector
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
CDS_API_KEY=your_uid:your_api_key

# Multilingual Translation Service
TRANSLATION_PROVIDER=mock              # Options: google, local, mock
GOOGLE_TRANSLATE_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account.json

# Voice Services (Speech-to-Text & Text-to-Speech)
STT_PROVIDER=mock                      # Options: whisper, bhashini, mock
TTS_PROVIDER=mock                      # Options: google, bhashini, mock

# System & Monitoring
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
